---
import Base from "../layouts/Base.astro";
import { doors } from "../data/functions";
import { href } from "../lib/href";
---

<Base
  title="Cek Dulu"
  description="Pilih satu fungsi. Setiap halaman punya satu tujuan."
>
  <header class="hero">
    <h1>Apa yang perlu Anda lakukan?</h1>
    <p class="lead">Pilih satu fungsi. Setiap halaman punya satu tujuan.</p>
    <p class="trust">Situs ini tidak meminta kode, PIN, atau data diri.</p>
  </header>

  <ul class="door-grid">
    {
      doors.map((door) => (
        <li>
          <a class="door-card" href={href(door.href)}>
            <strong>{door.title}</strong>
            <span>{door.line}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
