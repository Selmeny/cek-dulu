---
import Base from "../layouts/Base.astro";
import AnswerPath from "../components/AnswerPath.astro";
import SituationCard from "../components/SituationCard.astro";
import { href } from "../lib/href";
import { roles } from "../data/roles";
import { loadSituations } from "../lib/situations";

const items = await loadSituations();

const personal = [
  { id: "kode-whatsapp", text: "Jangan berikan kode WhatsApp kepada siapa pun." },
  { id: "tautan-hadiah", text: "Jangan ketuk tautan hadiah, paket, atau tagihan." },
  { id: "kata-sandi", text: "Buat kata sandi akun penting yang panjang dan berbeda." },
];

const organization = [
  { id: "data-orang-lain", text: "Jangan minta foto KTP atau PIN di chat." },
  { id: "belanja-daring", text: "Bayar di dalam aplikasi pasar bila barang ada di sana." },
  { id: "kata-sandi", text: "Buat kata sandi akun penting yang panjang dan berbeda." },
];
---

<Base
  title="Cek Dulu"
  description="Pilih langkah untuk diri Anda atau untuk usaha kecil Anda. Lakukan satu hal."
>
  <header class="hero">
    <h1>Apa yang dapat Anda lakukan?</h1>
    <p class="lead">
      Anda tidak perlu belajar istilah keamanan siber. Pilih satu jalur di bawah. Lakukan satu hal.
    </p>
    <p class="trust">Situs ini tidak meminta kode, PIN, atau data diri.</p>
  </header>

  <div class="answer-grid">
    <AnswerPath
      title="Untuk diri saya"
      line="Untuk ponsel, akun, dan uang Anda."
      tone="personal"
      steps={personal}
    />
    <AnswerPath
      title="Untuk usaha atau kelompok"
      line="Untuk toko kecil, kelas, arisan, atau kelompok yang menyimpan nama dan nomor orang lain."
      tone="org"
      steps={organization}
    />
  </div>

  <section class="band" aria-labelledby="cek-judul">
    <div>
      <h2 id="cek-judul">Tidak yakin jalur mana?</h2>
      <p>Delapan pertanyaan. Hasilnya hanya menunjukkan hal yang belum Anda lakukan. Jawaban tinggal di ponsel ini.</p>
    </div>
    <p><a class="button" href={href("/cek")}>Mulai cek singkat</a></p>
  </section>

  <section aria-labelledby="situasi-judul">
    <div class="section-head">
      <h2 id="situasi-judul">Kalau sesuatu sudah terjadi</h2>
    </div>
    <p class="lead">Pilih kejadiannya. Lakukan satu hal.</p>
    <ul class="tile-grid">
      {
        items.map((item) => (
          <li>
            <SituationCard id={item.id} title={item.data.title} number={item.data.order} />
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="peran-judul">
    <div class="section-head">
      <h2 id="peran-judul">Menurut peran Anda hari ini</h2>
    </div>
    <ul class="role-grid">
      {
        roles.map((role) => (
          <li>
            <a class="role-card" href={href(`/peran/${role.id}`)}>
              <strong>{role.title}</strong>
              <span>{role.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
