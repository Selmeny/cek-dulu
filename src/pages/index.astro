---
import Base from "../layouts/Base.astro";
import { href } from "../lib/href";
import { roles } from "../data/roles";
import { loadSituations } from "../lib/situations";

const items = await loadSituations();
---

<Base
  title="Cek Dulu"
  description="Pilih apa yang terjadi hari ini. Lakukan satu hal di ponsel Anda."
>
  <h1>Pilih apa yang terjadi. Lakukan satu hal.</h1>
  <p class="lead">
    Halaman ini untuk kejadian yang sudah Anda kenali. Anda tidak perlu belajar istilah keamanan siber sebelum mulai.
  </p>
  <p>Situs ini tidak meminta kode, PIN, atau data diri.</p>

  <h2>Apa yang terjadi</h2>
  <ul class="stack">
    {
      items.map((item) => (
        <li>
          <a class="card" href={href(`/situasi/${item.id}`)}>
            <strong>{item.data.title}</strong>
            <span>{item.data.action[0]}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Cek singkat</h2>
  <p>Delapan pertanyaan. Hasilnya hanya menunjukkan hal yang belum Anda lakukan. Jawaban tinggal di ponsel ini.</p>
  <p><a class="button" href={href("/cek")}>Mulai cek singkat</a></p>

  <h2>Menurut peran Anda hari ini</h2>
  <ul class="stack">
    {
      roles.map((role) => (
        <li>
          <a class="card" href={href(`/peran/${role.id}`)}>
            <strong>{role.title}</strong>
            <span>{role.line}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
