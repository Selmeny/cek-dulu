---
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/href";
import { roles } from "../../data/roles";
---

<Base
  title="Menurut peran"
  description="Pilih kegiatan kamu hari ini. Halaman itu yang cocok untuk kamu."
  section="peran"
>
  <h1>Menurut peran kamu hari ini</h1>
  <p class="lead">
    Pilih satu peran. Di halaman itu ada situasi untuk peran itu. Satu orang bisa punya lebih dari satu peran.
  </p>
  <ul class="role-grid">
    {
      roles.map((role) => (
        <li>
          <a class="role-card" href={href(`/peran/${role.id}`)}>
            <strong>{role.title}</strong>
            <span>{role.line}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
