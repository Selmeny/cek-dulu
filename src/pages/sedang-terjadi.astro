---
import SituationIndex from "../components/SituationIndex.astro";
import { doorById } from "../data/functions";
import { forGroup, loadSituations } from "../lib/situations";

const door = doorById("sedang");
const items = forGroup(await loadSituations(), "sedang");
---

<SituationIndex
  section={door.id}
  title={door.title}
  description={door.line}
  lead={door.line}
  items={items}
/>
