---
import Base from "../../layouts/Base.astro";
import ShareLink from "../../components/ShareLink.astro";
import { href } from "../../lib/href";
import { doorById } from "../../data/functions";
import { sourceById } from "../../data/sources";
import { roleById } from "../../data/roles";
import { loadSituations } from "../../lib/situations";

export async function getStaticPaths() {
  const items = await loadSituations();
  return items.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const shareText = `${data.title}. ${data.action[0]}`;
const door = doorById(data.group);
---

<Base title={data.title} description={data.lead} section={door.id}>
  <article class="situation">
    <header class="sit-head">
      <h1>{data.title}</h1>
      <p class="lead">{data.lead}</p>
    </header>

    <div class="sit-main">
      <section class="sit-action">
        <h2>Lakukan ini sekarang</h2>
        <div class="action">
          <ol class="steps">
            {
              data.action.map((step, index) => (
                <li>
                  <span class="step-no" aria-hidden="true">
                    {index + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
      <div class="sit-share">
        <ShareLink text={shareText} />
      </div>
    </div>

    <div class="sit-notes">
      <h2>Kenapa ini bahaya</h2>
      <p>{data.why}</p>

      <h2>Kalau sudah terlanjur</h2>
      <ul class="plain-list">
        {data.already.map((step) => <li>{step}</li>)}
      </ul>
      <ul class="plain-list">
        {
          data.report.map((item) => (
            <li>
              {item.href ? <a href={item.href}>{item.label}</a> : <strong>{item.label}</strong>}
              {". "}
              {item.note}
            </li>
          ))
        }
      </ul>

      <h2>Dari mana saran ini</h2>
      <p>{data.law}</p>
      <ul class="plain-list">
        {
          data.sources.map((id) => {
            const source = sourceById(id);
            return (
              <li>
                <a href={source.url}>{source.title}</a>
              </li>
            );
          })
        }
      </ul>
      <p class="muted">Daftar lengkapnya ada di <a href={href("/sumber")}>halaman sumber</a>.</p>

      <h2>Halaman ini bagian dari</h2>
      <p>
        Halaman ini ada di <a href={href(door.href)}>{door.title}</a>. {door.line}
      </p>

      <h2>Ini untuk siapa</h2>
      <ul class="chip-row">
        {
          data.roles.map((id) => {
            const role = roleById(id);
            return role ? (
              <li>
                <a href={href(`/peran/${role.id}`)}>{role.title}</a>
              </li>
            ) : null;
          })
        }
      </ul>
    </div>
  </article>
</Base>
