---
import Mark from "./Mark.astro";
import { href } from "../lib/href";

interface Props {
  id: string;
  title: string;
  number: number;
  start?: boolean;
}

const { id, title, number, start = false } = Astro.props;
const label = String(number).padStart(2, "0");
---

<a class:list={["tile", `tile-${id}`]} href={href(`/situasi/${id}`)}>
  <span class="tile-top">
    <Mark id={id} />
    <span class="tile-num" aria-hidden="true">{label}</span>
  </span>
  {start ? <span class="badge">Mulai dari sini</span> : null}
  <strong>{title}</strong>
</a>
