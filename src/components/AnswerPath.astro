---
import { href } from "../lib/href";

interface Step {
  id: string;
  text: string;
}

interface Props {
  title: string;
  line: string;
  tone: "personal" | "org";
  steps: Step[];
}

const { title, line, tone, steps } = Astro.props;
---

<section class:list={["answer-card", tone === "personal" ? "answer-personal" : "answer-org"]}>
  <h2 class="answer-title">{title}</h2>
  <p class="answer-line">{line}</p>
  <ol class="answer-steps">
    {
      steps.map((step, index) => (
        <li>
          <a href={href(`/situasi/${step.id}`)}>
            <span class="step-no" aria-hidden="true">
              {index + 1}
            </span>
            <span>{step.text}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>
