---
interface Report {
  label: string;
  href?: string;
  note: string;
}

interface Props {
  item: {
    id: string;
    data: {
      title: string;
      lead: string;
      action: string[];
      why: string;
      law: string;
      already: string[];
      report: Report[];
    };
  };
}

const { item } = Astro.props;
const { title, lead, action, why, law, already, report } = item.data;
---

<details data-topic={item.id}>
  <summary>
    <span>{title}</span>
  </summary>
  <p>{lead}</p>
  <h3>Lakukan ini sekarang</h3>
  <ul>
    {action.map((step) => <li>{step}</li>)}
  </ul>
  <p>{why}</p>
  <p>{law}</p>
  <h3>Kalau sudah terlanjur</h3>
  <ul>
    {already.map((step) => <li>{step}</li>)}
  </ul>
  <ul>
    {
      report.map((entry) => (
        <li>
          {entry.href ? <a href={entry.href}>{entry.label}</a> : <strong>{entry.label}</strong>}
          <span>{entry.note}</span>
        </li>
      ))
    }
  </ul>
  <div class="mark-row">
    <button
      type="button"
      class="mark"
      data-mark
      role="checkbox"
      aria-checked="false"
      aria-label={`Saya mengerti: ${title}`}
    >
      <span>Saya mengerti</span>
      <span class="mark-box" aria-hidden="true">
        <svg class="mark-icon" viewBox="0 0 24 24" focusable="false">
          <path
            d="M5 12.5 9.5 17 19 7.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>
  </div>
</details>
