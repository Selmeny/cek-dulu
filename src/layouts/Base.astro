---
import { doors, type DoorId } from "../data/functions";
import { href } from "../lib/href";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  section?: DoorId;
}

const { title, description, section } = Astro.props;
const pageTitle = title === "Cek Dulu" ? title : `${title} — Cek Dulu`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f2ee" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#isi">Langsung ke isi</a>
    <header class="site-head">
      <div class="shell bar">
        <a class="brand" href={href("/")}>Cek Dulu</a>
        <nav class="site-nav" aria-label="Utama">
          {
            doors.map((door) => (
              <a href={href(door.href)} aria-current={section === door.id ? "page" : undefined}>
                {door.nav}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="isi" class="shell main">
      <slot />
    </main>
    <footer class="shell site-foot">
      <p>
        Info umum. Bukan situs pemerintah. Bukan nasihat hukum. Situs ini tidak minta kode, PIN, atau data diri.
      </p>
      <p class="foot-links">
        <a href={href("/sumber")}>Sumber</a>
        <a href={href("/tentang")}>Tentang situs ini</a>
      </p>
    </footer>
  </body>
</html>
