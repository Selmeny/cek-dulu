---
import { href } from "../lib/href";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === "Cek Dulu" ? title : `${title} — Cek Dulu`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#isi">Langsung ke isi</a>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href={href("/")}>Cek Dulu</a>
        <nav class="site-nav" aria-label="Utama">
          <a href={href("/cek")}>Cek singkat</a>
          <a href={href("/sumber")}>Sumber</a>
        </nav>
      </header>
      <main id="isi">
        <slot />
      </main>
      <footer class="site-foot">
        <p>
          Informasi umum. Bukan situs pemerintah. Bukan nasihat hukum. Situs ini tidak meminta kode, PIN, atau data diri.
        </p>
        <p>
          <a href={href("/tentang")}>Tentang situs ini</a>
        </p>
      </footer>
    </div>
  </body>
</html>
